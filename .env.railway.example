# ===================================
# Variables de entorno para Railway
# ===================================

# Railway proporciona PORT automáticamente
# No es necesario configurarlo manualmente

# PostgreSQL (Railway proporciona DATABASE_URL)
# Puedes usar DATABASE_URL directamente o estas variables:
DB_HOST=${{PGHOST}}
DB_PORT=${{PGPORT}}
DB_USER=${{PGUSER}}
DB_PASSWORD=${{PGPASSWORD}}
DB_NAME=${{PGDATABASE}}

# JWT Secrets (OBLIGATORIO: cambiar en producción)
JWT_SECRET=your_production_jwt_secret_minimum_32_characters_long
REFRESH_TOKEN_SECRET=your_production_refresh_secret_minimum_32_characters

# Frontend URL (actualizar con dominio de Railway)
FRONTEND_URL=https://your-frontend.railway.app

# Email Configuration (usar servicio real en producción)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=your_sendgrid_api_key

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Redis (Railway proporciona REDIS_URL)
# Puedes usar REDIS_URL directamente o estas variables:
REDIS_HOST=${{REDIS.REDIS_HOST}}
REDIS_PORT=${{REDIS.REDIS_PORT}}
REDIS_PASSWORD=${{REDIS.REDIS_PASSWORD}}

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-api.railway.app/api/v1/auth/google/callback
